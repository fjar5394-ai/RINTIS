# TEMPLATE ONLY. Replace placeholders in the staging secret/config store.
APP_NAME=RINTIS
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.invalid

DB_CONNECTION=mysql
DB_HOST=SET_STAGING_DB_HOST
DB_PORT=4000
DB_DATABASE=rintis_staging
DB_USERNAME=SET_STAGING_DB_USERNAME
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

SESSION_SECURE_COOKIE=true
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
